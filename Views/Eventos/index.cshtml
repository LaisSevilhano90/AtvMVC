@model List<Evento>

@{
    ViewData["Title"] = "Listagem de Eventos";
}

<h1>Listagem Geral de Alunos</h1>

<table>
    <tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Descricao</th>
        <th>Local</th>
        <th>DataEvento</th>
        <th>QntdVagas</th>
        <th>ValorIngresso</th>
    </tr>
    @foreach(Evento e in Model)
    {
        <tr>
            <th>@e.Id</th>
            <th>@e.Nome</th>
            <th>@e.Descricao</th>
            <th>@e.Local</th>
            <th>@e.DataEvento</th>
            <th>@e.QntdVagas</th>
            <th>@e.ValorIngresso</th>
            <th>
                <a esp-action="Detalhes" asp-route-id="@e.Id">Ver</a>
            </th>
        </tr>
    }
</table>